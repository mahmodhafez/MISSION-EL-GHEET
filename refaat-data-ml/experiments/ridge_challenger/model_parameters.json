    },
    "features": {
      "count": 10,
      "notation": "D=issue; C=D-7; h in 1..7; T=D+h; z_v(t)=float64(float32(observed v(t)))",
      "calendar_phase": "p(T)=(date(2000,T.month,T.day)-date(2000,1,1)).days; p in 0..365",
      "ordered_definitions": [
        {
          "name": "target_annual_sin",
          "formula": "sin(2*pi*p(T)/366)",
          "available": "deterministic target date known at D"
        },
        {
          "name": "target_annual_cos",
          "formula": "cos(2*pi*p(T)/366)",
          "available": "deterministic target date known at D"
        },
        {
          "name": "tmax_last",
          "formula": "z_tmax_c(C)",
          "available": "C=D-7"
        },
        {
          "name": "tmax_mean_7",
          "formula": "sum(z_tmax_c(C-i), i=0..6)/7",
          "available": "C-6..C, inclusive"
        },
        {
          "name": "tmax_mean_30",
          "formula": "sum(z_tmax_c(C-i), i=0..29)/30",
          "available": "C-29..C, inclusive"
        },
        {
          "name": "tmax_mean_60",
          "formula": "sum(z_tmax_c(C-i), i=0..59)/60",
          "available": "C-59..C, inclusive"
        },
        {
          "name": "et0_last",
          "formula": "z_et0_mm_day(C)",
          "available": "C=D-7"
        },
        {
          "name": "et0_mean_7",
          "formula": "sum(z_et0_mm_day(C-i), i=0..6)/7",
          "available": "C-6..C, inclusive"
        },
        {
          "name": "et0_mean_30",
          "formula": "sum(z_et0_mm_day(C-i), i=0..29)/30",
          "available": "C-29..C, inclusive"
        },
        {
          "name": "et0_mean_60",
          "formula": "sum(z_et0_mm_day(C-i), i=0..59)/60",
          "available": "C-59..C, inclusive"
        }
      ],
      "rolling_aggregation": "math.fsum in float64 over chronological values, divided by window size",
      "matrix_dtype": "float64",
      "feature_selection": "none",
      "interactions_or_extra_harmonics": false,
      "future_weather_qc_or_other_covariates": false
    },
    "preprocessing": {
      "estimator": "sklearn.preprocessing.StandardScaler",
      "parameters": {
        "copy": true,
        "with_mean": true,
        "with_std": true
      },
      "scope": "one fitted scaler per target/lead pipeline; only that model's 6501 training feature rows",
      "formula": "(x_j-mu_j)/s_j; mu and variance fitted on training rows only; variance uses ddof=0",
      "constant_feature_scale": 1.0,
      "source_precision": "quantize historical observations and labels with existing climate_data.climatology.float32; promote to float64 for arithmetic/fitting",
      "label_transform": "identity after float32 quantization; physical target units",
      "inverse_label_transform": "not applicable",
      "missing_data_policy": "fail on absent, duplicate, noncontiguous, fill or nonfinite data; no imputation, partial rolling windows, interpolation or row dropping",
      "outlier_policy": "retain validated extremes and review-flagged observations; no QC features or filtering",
      "prediction_postprocessing": "none; retain and report any negative ET0 prediction without clipping"
    },
    "ridge": {
      "estimator": "sklearn.linear_model.Ridge",
      "parameters": {
        "alpha": 1.0,
        "fit_intercept": true,
        "copy_X": true,
        "max_iter": null,
        "tol": 0.0001,
        "solver": "svd",
        "positive": false,
        "random_state": null
      },
      "objective": "sum_i((y_i-intercept-X_scaled_i*coef)^2) + alpha*sum_j(coef_j^2)",
      "parameter_policy": "fixed before Ridge fitting; no RidgeCV, search, alternate feature sets, early stopping or validation-driven changes"
    },
    "execution": {
      "hardware": "CPU",
      "blas_thread_limit": 1,
      "thread_limit_method": "threadpoolctl.threadpool_limits(limits=1)",
      "random_operations": "none",
