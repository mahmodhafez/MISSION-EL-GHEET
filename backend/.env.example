# Copy to .env (git-ignored). No secrets in this file.
MEG_DB_PATH=backend/var/meg.sqlite3
# "reviewed" = Refaat's reviewed Sakha KB (default). A path = a planner fixture KB, e.g.
# packages/meg-core/tools/fixtures/uh001.json for the golden UH-001 test.
MEG_DATA_RELEASE_PATH=reviewed
# Season Replay climate data (default: the repo release under refaat-data-ml/data).
MEG_CLIMATE_DATA_DIR=
MEG_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Speech interpretation (Gemini strict extraction). Empty key = interpreter not configured.
MEG_GEMINI_API_KEY=
MEG_GEMINI_MODEL=gemini-3.8-flash
# Pre-generated prompt audio (ElevenLabs, offline only). Missing = not_generated.
MEG_AUDIO_DIR=frontend/public/audio
# Forecast bundle from ML (D3). Missing = unavailable.
MEG_FORECAST_BUNDLE=data/release/forecast_bundle.json
