# Supply-chain rules (docs/rules/dependencies.md). pnpm >= 10.16 enforces these; the pinned
# packageManager (pnpm 10.34.9, hash-checked by corepack) is the version to use.
# Never resolve a package version published less than 14 days ago (minutes).
minimum-release-age=20160
# Exact versions only when adding packages.
save-exact=true
# Dependency install scripts stay blocked (pnpm 10 default); allow one only by listing it in
# pnpm.onlyBuiltDependencies after review.
